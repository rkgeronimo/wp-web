{% if memberCard.validUntil %}
    {% set cardName = "#{user.first_name} #{user.last_name}"|trim %}
    {% if cardName is empty %}
        {% set cardName = user.display_name %}
    {% endif %}
    {% set cardPicture = function('get_user_meta', user.ID, 'brevet', true) %}
    <div class="member-card">
        <svg class="member-card-bg" viewBox="0 0 856 540" preserveAspectRatio="xMidYMid slice" fill="#fff" aria-hidden="true">
            <defs>
                <path id="mc-fish" d="M0 10 Q12 0 24 10 Q12 20 0 10Z M24 10 L33 3 L33 17Z"/>
                <polygon id="mc-star" points="0,-20 5,-6 20,-6 8,3 12,18 0,9 -12,18 -8,3 -20,-6 -5,-6"/>
                <path id="mc-seahorse" d="M0 0 c9 -1 13 7 7 11 c-6 4 -9 10 -3 17 c6 8 0 17 -7 13 c5 -2 5 -7 0 -9 c-9 -6 -7 -16 -1 -22 c2 -2 -2 -4 -6 -4 l-9 3 l6 -7 c2 -2 8 -2 13 -2z"/>
                <g id="mc-crab">
                    <ellipse cx="0" cy="0" rx="14" ry="9"/>
                    <circle cx="-20" cy="-12" r="5"/>
                    <circle cx="20" cy="-12" r="5"/>
                    <path d="M-10 -5 L-18 -10 M10 -5 L18 -10 M-12 4 L-22 10 M-13 0 L-24 2 M12 4 L22 10 M13 0 L24 2" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                </g>
                <g id="mc-weed" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round">
                    <path d="M0 0 q-10 -20 0 -40 t0 -40"/>
                    <path d="M14 0 q10 -16 0 -32 t0 -30"/>
                </g>
                <path id="mc-coral" d="M0 0 L0 -40 M0 -20 L-16 -36 M0 -28 L14 -48 M-16 -36 L-20 -50 M14 -48 L24 -56" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round"/>
                <g id="mc-bubbles" fill="none" stroke="#fff" stroke-width="3">
                    <circle cx="0" cy="0" r="8"/>
                    <circle cx="-14" cy="-20" r="5"/>
                    <circle cx="4" cy="-36" r="3.5"/>
                </g>
            </defs>
            <image href="{{ site.theme.link }}/assets/img/logo-white.png" x="470" y="70" width="400" height="400" opacity=".08"/>
            <g opacity=".1">
                <use href="#mc-weed" transform="translate(30 545) scale(1.6)"/>
                <use href="#mc-coral" transform="translate(130 545) scale(1.5)"/>
                <use href="#mc-weed" transform="translate(360 545) scale(1.3)"/>
                <use href="#mc-coral" transform="translate(720 545) scale(1.3)"/>
                <use href="#mc-weed" transform="translate(800 545) scale(1.5)"/>
                <use href="#mc-crab" transform="translate(250 500) scale(2)"/>
                <use href="#mc-star" transform="translate(600 505) rotate(-10) scale(1.6)"/>
                <use href="#mc-seahorse" transform="translate(440 330) scale(2)"/>
                <use href="#mc-fish" transform="translate(520 40) scale(2)"/>
                <use href="#mc-fish" transform="translate(590 75) scale(1.5)"/>
                <use href="#mc-fish" transform="translate(380 60) scale(1.2)"/>
                <use href="#mc-fish" transform="translate(650 25) scale(1.7)"/>
                <use href="#mc-fish" transform="translate(720 55) scale(1.3)"/>
                <use href="#mc-fish" transform="translate(470 85) scale(1.1)"/>
                <use href="#mc-fish" transform="translate(780 20) scale(1.1)"/>
                <use href="#mc-fish" transform="translate(670 95) scale(1)"/>
                <use href="#mc-bubbles" transform="translate(480 300) scale(.8)"/>
            </g>
        </svg>
        <div class="member-card-content">
            <div class="member-card-header">
                <img src="{{ site.theme.link }}/assets/img/logo-white.png" alt="" />
                <div>RK GERONIMO<small>Članska iskaznica</small></div>
            </div>
            <div class="member-card-body">
                {% if cardPicture %}
                    <img class="member-card-photo" src="{{ cardPicture|e('html_attr') }}" alt="{{ cardName|e('html_attr') }}" />
                {% else %}
                    <span class="member-card-photo member-card-photo-placeholder"><i class="fas fa-user"></i></span>
                {% endif %}
                <div>
                    <div class="member-card-name">{{ cardName|e }}</div>
                    <div class="member-card-fields">
                        {% if user.rc %}
                            <div>
                                <div class="member-card-label">Kategorija</div>
                                <div class="member-card-value">{{ user.rc|e }}</div>
                            </div>
                        {% endif %}
                    </div>
                    <div class="member-card-fields">
                        <div>
                            <div class="member-card-label">Vrijedi do</div>
                            <div class="member-card-value">31.12.{{ memberCard.validUntil }}.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="member-card-footer">
                <span><span class="member-card-dot"></span>Važeća</span>
                <span class="member-card-clock"></span>
            </div>
        </div>
    </div>
{% else %}
    <p>Članska iskaznica</p>
    <p>Članarina za {{ 'now'|date('Y') }}. godinu nije plaćena pa iskaznica nije važeća.</p>
{% endif %}
