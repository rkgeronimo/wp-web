{% block content %}
<div class="wrap">
    {% if editUser %}
        <h1 class="wp-heading-inline">Ronilački profil — {{ editUser.display_name }}</h1>
        <p><a href="{{ listUrl }}">&larr; Natrag na popis profila</a></p>
        {% if saved %}
            <div class="notice notice-success is-dismissible"><p>Spremljeno.</p></div>
        {% endif %}
        <form method="post" action="{{ formAction }}">
            {{ nonceField|raw }}
            <input type="hidden" name="user_id" value="{{ editUser.ID }}">
            {% include 'diverProfile.twig' %}
            <p class="submit">
                <button type="submit" class="button button-primary">Spremi</button>
            </p>
        </form>
    {% else %}
        <h1 class="wp-heading-inline">Ronilački profili</h1>
        <hr class="wp-header-end">
        <form method="get">
            <input type="hidden" name="page" value="rkg_diver_profiles">
            {{ table.search_box('Pretraga', 'diver_search') }}
        </form>
        <form method="get">
            <input type="hidden" name="page" value="rkg_diver_profiles">
            {{ table.display() }}
        </form>
    {% endif %}
</div>
{% endblock %}
